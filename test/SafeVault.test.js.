const { expect } = require("chai");
const { ethers } = require("hardhat");

describe("SafeVault", function () {
  async function deployFixture() {
    const [owner, alice, bob] = await ethers.getSigners();

    const Token = await ethers.getContractFactory("MockToken");
    const token = await Token.deploy();

    const Vault = await ethers.getContractFactory("SafeVault");
    const vault = await Vault.deploy(
      await token.getAddress(),
      1000
    );

    const amount = ethers.parseEther("1000");

    await token.transfer(alice.address, amount);
    await token.connect(alice).approve(
      await vault.getAddress(),
      amount
    );

    return { owner, alice, bob, token, vault, amount };
  }

  it("allows a user to lock tokens", async function () {
    const { alice, token, vault, amount } = await deployFixture();

    await vault.connect(alice).lockTokens(amount, 3600);

    const compartment = await vault
      .connect(alice)
      .getMyCompartment();

    expect(compartment.amount).to.equal(amount);
    expect(compartment.active).to.equal(true);

    expect(
      await token.balanceOf(await vault.getAddress())
    ).to.equal(amount);
  });

  it("prevents unlocking before the lock expires", async function () {
    const { alice, vault, amount } = await deployFixture();

    await vault.connect(alice).lockTokens(amount, 3600);

    await expect(
      vault.connect(alice).unlockTokens()
    ).to.be.revertedWith("Still locked");
  });

  it("keeps each user's compartment separate", async function () {
    const { alice, bob, vault, amount } = await deployFixture();

    await vault.connect(alice).lockTokens(amount, 3600);

    const aliceCompartment = await vault
      .connect(alice)
      .getMyCompartment();

    const bobCompartment = await vault
      .connect(bob)
      .getMyCompartment();

    expect(aliceCompartment.amount).to.equal(amount);
    expect(aliceCompartment.active).to.equal(true);
    expect(bobCompartment.amount).to.equal(0);
    expect(bobCompartment.active).to.equal(false);
  });

  it("calculates rewards without distributing them", async function () {
    const { alice, vault, amount } = await deployFixture();

    await vault
      .connect(alice)
      .lockTokens(amount, 30 * 24 * 60 * 60);

    await ethers.provider.send("evm_increaseTime", [86400]);
    await ethers.provider.send("evm_mine", []);

    const reward = await vault
      .connect(alice)
      .calculateReward();

    expect(reward).to.be.greaterThan(0);

    const compartment = await vault
      .connect(alice)
      .getMyCompartment();

    expect(compartment.amount).to.equal(amount);
    expect(compartment.active).to.equal(true);

    expect(
      await vault.connect(alice).calculateReward()
    ).to.equal(reward);
  });

  it("allows a user to unlock tokens after expiry", async function () {
    const { alice, token, vault, amount } = await deployFixture();

    await vault
      .connect(alice)
      .lockTokens(amount, 3600);

    await ethers.provider.send("evm_increaseTime", [3601]);
    await ethers.provider.send("evm_mine", []);

    await vault.connect(alice).unlockTokens();

    const compartment = await vault
      .connect(alice)
      .getMyCompartment();

    expect(compartment.amount).to.equal(0);
    expect(compartment.active).to.equal(false);

    expect(
      await token.balanceOf(alice.address)
    ).to.equal(amount);
  });

  it("rejects zero token amounts", async function () {
    const { alice, vault } = await deployFixture();

    await expect(
      vault.connect(alice).lockTokens(0, 3600)
    ).to.be.revertedWith("Amount must be positive");
  });

  it("rejects zero lock duration", async function () {
    const { alice, vault, amount } = await deployFixture();

    await expect(
      vault.connect(alice).lockTokens(amount, 0)
    ).to.be.revertedWith("Duration must be positive");
  });

  it("prevents a second active compartment for the same user", async function () {
    const { alice, vault, amount } = await deployFixture();

    await vault.connect(alice).lockTokens(amount, 3600);

    await expect(
      vault.connect(alice).lockTokens(amount, 3600)
    ).to.be.revertedWith("Compartment active");
  });
});
